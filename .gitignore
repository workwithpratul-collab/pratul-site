# OS junk files (never useful in the project)
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.swp
*~

# Editor settings that are personal to one machine
.vscode/*
!.vscode/settings.json

# Note: assets/ and recordings/ are deliberately NOT ignored.

# Test screenshots (Phase 7 device checks): kept on disk, not in Git.
tests/

# Full-size source files: kept on this computer, not on GitHub. The site only uses the
# smaller .webp versions made from them.
assets/originals/
assets/redesign/*.png
assets/redesign/about-photo.jpg
references/mockups/

# The design checker's private cache (rebuilt on its own).
.impeccable/hook.cache.json
